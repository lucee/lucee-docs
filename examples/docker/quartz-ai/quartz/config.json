{
	"jobs": [
		{
			"label": "Feed watcher",
			"component": "jobs.FeedWatchJob",
			"cron": "0 */5 * * * ?",
			"mode": "transient",
			"pause": false,
			"aiConnection": "watcher",
			"outputDirectory": "/opt/lucee/output",
			"sampleFeed": "/opt/lucee/sample-data/sample-feed.json"
		}
	],
	"listeners": [
		{
			"component": "listeners.JobStatsListener",
			"outputDirectory": "/opt/lucee/output",
			"tokenWarning": 5000
		}
	]
}
