# AI connection "watcher" (see lucee-config.json). By default it uses Claude (Anthropic).
# Leave AI_SECRET_KEY empty to run without AI, the job then falls back to the keyword rule only.
# AI_URL is optional for Claude (defaults to https://api.anthropic.com/v1/).
# To use an OpenAI compatible endpoint instead, see readme.md.
AI_URL=
AI_SECRET_KEY=
AI_MODEL=claude-sonnet-4-6

# Feed to check. Leave empty to use the bundled sample feed.
# Expected format: JSON array of { "id", "title", "body" } (see data/sample-feed.json)
FEED_URL=

# comma separated keywords for the pre filter
WATCH_KEYWORDS=error,crash,outage,security,urgent,down

LUCEE_ADMIN_PASSWORD=qwerty
