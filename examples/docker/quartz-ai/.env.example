# AI connection (any OpenAI compatible endpoint). Leave empty to run without AI,
# the job then falls back to the keyword rule only.
AI_URL=
AI_SECRET_KEY=
AI_MODEL=

# Feed to check. Leave empty to use the bundled sample feed.
# Expected format: JSON array of { "id", "title", "body" } (see data/sample-feed.json)
FEED_URL=

# comma separated keywords for the pre filter
WATCH_KEYWORDS=error,crash,outage,security,urgent,down

LUCEE_ADMIN_PASSWORD=qwerty
